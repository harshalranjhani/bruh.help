AI_PROVIDER=groq

# Required when AI_PROVIDER=groq
GROQ_API_KEY=

# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=bruh.help

# Required when AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# Optional JSON object string for provider headers
OPENAI_COMPATIBLE_HEADERS_JSON=

# Optional model id overrides
MODEL_CONTESTANT_A_ID=
MODEL_CONTESTANT_B_ID=
MODEL_JUDGE_1_ID=
MODEL_JUDGE_2_ID=

STACK_EXCHANGE_KEY=
ADMIN_SECRET=
DATABASE_PATH=bruh-help.sqlite
PORT=5109

# Optional broadcast streaming endpoint
STREAM_RTMP_URL=

# Optional limits
HISTORY_LIMIT_PER_MIN=120
ADMIN_LIMIT_PER_MIN=10
MAX_WS_GLOBAL=100000
MAX_WS_PER_IP=8
MAX_WS_NEW_PER_SEC=50
